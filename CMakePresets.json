{
   "version": 3,
   "configurePresets": [
      {
         "name": "vcpkg",
         "generator": "Ninja",
         "binaryDir": "${sourceDir}/build/${presetName}",
         "toolchainFile": "${sourceDir}/eruptor/vcpkg/scripts/buildsystems/vcpkg.cmake",
         "cacheVariables": {
            "VCPKG_MANIFEST_DIR": "${sourceDir}/eruptor"
         }
      }
   ]
}